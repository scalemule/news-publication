{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scalemule.com/contracts/ads/ad-plan.schema.json",
  "title": "ScaleMule Ads plan response (wire)",
  "description": "What scalemule-ads returns from POST /v1/ads/plan inside the {success,data} envelope. The SDK (getAdPlan) signs each delivery's fallback href from destination_url and strips destination_url and tier before the plan reaches a page. ADR-2026-10-29 sections 6.1 and 7.5.2. This file is the single contract: scalemule-ads vendors it verbatim and validates its serialized responses against it; the SDK validates contracts/fixtures/service-wire/*.json written from the service's real serializer. Revision 9 adds the advertiser brand kit (delivery.brand) and the photo and artwork creative modes (content.mode, image_wide, image_tall, focal, artwork, artwork_cta).",
  "type": "object",
  "required": [
    "status",
    "plan_id",
    "policy_snapshot_at",
    "deliveries",
    "empty"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok"
      ],
      "description": "The service always answers ok; the SDK sets unavailable itself when it could not get an answer."
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "policy_snapshot_at": {
      "type": "string",
      "format": "date-time"
    },
    "deliveries": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/placementKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/delivery"
      }
    },
    "empty": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/placementKey"
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "enum": [
        "policy_stale",
        "sensitive",
        "blocked",
        "no_inventory",
        "preview"
      ],
      "description": "Why the plan has no (or forced) deliveries. Optional; informational only."
    },
    "page_sponsor": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuidv7"
        },
        {
          "type": "null"
        }
      ],
      "description": "The flight that won page exclusivity, or null."
    },
    "preview": {
      "type": "boolean",
      "description": "True when a preview token forced the creative; deliveries are logged preview=true and excluded from stats."
    }
  },
  "$defs": {
    "placementKey": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,40}$"
    },
    "uuidv7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "format": {
      "type": "string",
      "enum": [
        "band",
        "column",
        "inline_card",
        "partner_footer",
        "credit_line",
        "showcase"
      ]
    },
    "label": {
      "type": "string",
      "enum": [
        "advertisement",
        "sponsored"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "cookieless",
        "performance",
        "advertising"
      ]
    },
    "image": {
      "type": "object",
      "required": [
        "url",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "alt": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "advertiser",
        "headline",
        "description",
        "cta"
      ],
      "additionalProperties": false,
      "properties": {
        "advertiser": {
          "type": "string",
          "maxLength": 60
        },
        "headline": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 120
        },
        "cta": {
          "type": "string",
          "maxLength": 20
        },
        "link_label": {
          "type": "string",
          "maxLength": 40
        },
        "logo": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "image": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "typographic",
            "photo",
            "artwork"
          ],
          "description": "How the creative is drawn; default typographic. artwork falls back to photo, then typographic, for a format without art."
        },
        "image_wide": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ],
          "description": "photo mode: wide photograph (about 1200x420) for band and partner_footer."
        },
        "image_tall": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ],
          "description": "photo mode: tall photograph (about 300x400) for column."
        },
        "focal": {
          "oneOf": [
            {
              "$ref": "#/$defs/focal"
            },
            {
              "type": "null"
            }
          ],
          "description": "photo mode: subject position 0-1 from the top-left; drives object-position."
        },
        "artwork": {
          "oneOf": [
            {
              "$ref": "#/$defs/artwork"
            },
            {
              "type": "null"
            }
          ]
        },
        "artwork_cta": {
          "type": "boolean",
          "description": "artwork mode: draw a 44px CTA strip under the art when cta is set."
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "delivery_id",
        "flight_id",
        "creative_id",
        "revision",
        "format",
        "content",
        "href",
        "label",
        "about"
      ],
      "additionalProperties": false,
      "properties": {
        "delivery_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "flight_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "creative_id": {
          "$ref": "#/$defs/uuidv7"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "href": {
          "type": "string",
          "pattern": "^/go/[0-9a-f-]{36}$"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "about": {
          "type": "object",
          "required": [
            "advertiser"
          ],
          "additionalProperties": false,
          "properties": {
            "advertiser": {
              "type": "string",
              "maxLength": 60
            },
            "policy_path": {
              "type": "string",
              "pattern": "^/",
              "maxLength": 200
            }
          }
        },
        "insertion_point": {
          "type": "string",
          "pattern": "^p[0-9]{1,4}$"
        },
        "destination_url": {
          "type": "string",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "tier": {
          "$ref": "#/$defs/tier"
        },
        "brand": {
          "oneOf": [
            {
              "$ref": "#/$defs/brand"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "brand": {
      "type": "object",
      "required": [
        "surface",
        "ink",
        "ink_muted",
        "accent",
        "on_accent"
      ],
      "additionalProperties": false,
      "description": "The advertiser's brand kit (revision 9): plain hex colors, a text wordmark drawn in the paper's display serif, an eyebrow, a resolved context line and an optional secondary link. The SDK signs secondary.url into its own /go route.",
      "properties": {
        "surface": {
          "$ref": "#/$defs/hex"
        },
        "ink": {
          "$ref": "#/$defs/hex"
        },
        "ink_muted": {
          "$ref": "#/$defs/hex"
        },
        "accent": {
          "$ref": "#/$defs/hex"
        },
        "on_accent": {
          "$ref": "#/$defs/hex"
        },
        "footer": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "surface",
                "ink",
                "ink_muted"
              ],
              "additionalProperties": false,
              "properties": {
                "surface": {
                  "$ref": "#/$defs/hex"
                },
                "ink": {
                  "$ref": "#/$defs/hex"
                },
                "ink_muted": {
                  "$ref": "#/$defs/hex"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "wordmark": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "mark": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "eyebrow": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "label",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://",
                  "maxLength": 2048
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "focal": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "artwork": {
      "type": "object",
      "additionalProperties": false,
      "description": "Finished art per format at the exact box: band 1200x280, band_mobile 360x360, column 300x520, inline_card 680x350, inline_card_mobile any 3:2, partner_footer 1200x240, partner_footer_mobile 360x300. The SDK drops an entry whose size does not match.",
      "properties": {
        "band": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "band_mobile": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "column": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "inline_card": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "inline_card_mobile": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "partner_footer": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        },
        "partner_footer_mobile": {
          "oneOf": [
            {
              "$ref": "#/$defs/image"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
