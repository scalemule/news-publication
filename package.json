{
  "name": "@scalemule/news-publication",
  "version": "0.0.13",
  "description": "Shared server framework for ScaleMule local news publications. Walnut Creek Times is the broadsheet default; each paper supplies its own identity and feature flags.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./tokens/broadsheet.css",
    "./snapshot-file": {
      "types": "./dist/snapshot-file.d.ts",
      "import": "./dist/snapshot-file.js",
      "require": "./dist/snapshot-file.cjs"
    },
    "./marketplace": {
      "types": "./dist/marketplace-view.d.ts",
      "import": "./dist/marketplace-view.js",
      "require": "./dist/marketplace-view.cjs"
    },
    "./marketplace-forms": {
      "types": "./dist/marketplace-forms.d.ts",
      "import": "./dist/marketplace-forms.js",
      "require": "./dist/marketplace-forms.cjs"
    },
    "./marketplace.css": "./marketplace.css",
    "./meet": {
      "types": "./dist/meet-view.d.ts",
      "import": "./dist/meet-view.js",
      "require": "./dist/meet-view.cjs"
    },
    "./meet-forms": {
      "types": "./dist/meet-forms.d.ts",
      "import": "./dist/meet-forms.js",
      "require": "./dist/meet-forms.cjs"
    },
    "./cookie-consent-banner": {
      "types": "./dist/cookie-consent-banner.d.ts",
      "import": "./dist/cookie-consent-banner.js",
      "require": "./dist/cookie-consent-banner.cjs"
    },
    "./cookie-settings-view": {
      "types": "./dist/cookie-settings-view.d.ts",
      "import": "./dist/cookie-settings-view.js",
      "require": "./dist/cookie-settings-view.cjs"
    },
    "./cookie-consent.css": "./cookie-consent.css",
    "./theme-toggle": {
      "types": "./dist/theme-toggle.d.ts",
      "import": "./dist/theme-toggle.js",
      "require": "./dist/theme-toggle.cjs"
    }
  },
  "files": [
    "dist",
    "tokens",
    "marketplace.css",
    "cookie-consent.css",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup && node scripts/mark-client-forms.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "node -e \"const v=require('./package.json').version; if(!/^0\\.(0|1)\\.\\d+$/.test(v)){console.error('ERR: SDK '+v+' violates patch-only policy (0.0.x or 0.1.x only). See CONTRIBUTING.md SDK versioning section.');process.exit(1)}\" && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "scalemule",
    "news",
    "publication",
    "napsite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scalemule/news-publication.git"
  },
  "author": "ScaleMule Inc. <support@scalemule.com>",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
